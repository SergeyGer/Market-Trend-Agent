# =============================================================================
# Market & Trend Intelligence Agent — Environment Configuration Example
# =============================================================================
# Copy this file to `.env` and replace the placeholder values with real ones.
# The `.env` file must not be committed to git (contains secrets).
# =============================================================================


# -----------------------------------------------------------------------------
# Anthropic (AI article analysis)
# -----------------------------------------------------------------------------

# API key for Anthropic Claude access.
# Get it at: https://console.anthropic.com/ -> API Keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# -----------------------------------------------------------------------------
# Notion (Analysis results storage)
# -----------------------------------------------------------------------------

# Notion integration token (Internal Integration Secret).
# In the Notion documentation, it is sometimes called NOTION_TOKEN — this project
# uses the name NOTION_API_KEY.
# Get it at: https://www.notion.so/my-integrations -> New integration -> Secrets
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion database ID where analyzed articles are written.
# Format: 32 characters (with or without hyphens).
# Find it: open the database in Notion -> "..." -> Copy link -> ID from URL
# URL Example: https://notion.so...
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Override Notion database property names ---
# Specify only if your columns in Notion are named differently from the defaults.
# Names must exactly match the property headers in the database.

# Title type property — article title
NOTION_PROP_TITLE=Title

# Select type property — category (AI/LLM, Macro/VC, Competitor Move,
# Infrastructure, Irrelevant). All these options must exist in Select.
NOTION_PROP_CATEGORY=Category

# Number type property — impact score (1–5)
NOTION_PROP_IMPACT=Impact Score

# Rich Text type property — extracted metrics and figures
NOTION_PROP_METRICS=Metrics

# URL type property — link to the original article
NOTION_PROP_URL=URL


# -----------------------------------------------------------------------------
# Telegram (Alerts on high-impact events)
# -----------------------------------------------------------------------------

# Telegram bot token from @BotFather (/newbot).
# Used to send notifications when impact_score >= 4.
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Chat or channel ID where the bot sends alerts.
# For a personal chat: message the bot, then GET https://api.telegram.org/bot<TOKEN>/getUpdates
# For a channel: usually starts with -100...
TELEGRAM_CHAT_ID=-1001234567890


# -----------------------------------------------------------------------------
# Data Sources (Ingestion)
# -----------------------------------------------------------------------------

# RSS feeds separated by commas (no spaces required — they are stripped).
# Example: multiple feed URLs in a row, separated by a comma.
RSS_FEED_URLS=https://feeds.example.com/ai-news.xml,https://feeds.example.com/vc.xml

# JSON API endpoints separated by commas — alternative article sources.
# Expected JSON with an array of items/articles/posts and title, url, content fields.
JSON_ENDPOINT_URLS=https://api.example.com/v1/market-news.json


# -----------------------------------------------------------------------------
# Other
# -----------------------------------------------------------------------------

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
